# Нормализуем окончания строк: в репозитории всегда LF
* text=auto eol=lf

# Бинарные файлы: не трогать при checkout и в диффах
*.png  binary
*.ico  binary
*.woff2 binary
*.pdf  binary

# Windows-скрипты, если появятся
*.bat text eol=crlf
*.cmd text eol=crlf

# Сгенерированное: не раздувать статистику языков и ревью
go.sum                      linguist-generated=true
frontend/package-lock.json  linguist-generated=true
